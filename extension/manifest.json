{
  "manifest_version": 3,
  "name": "Profile Signals",
  "version": "0.4.0",
  "description": "Reads what LinkedIn shows about a member profile and rates it locally with your own rules.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Profile Signals",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["inspector.js", "verdict.js", "extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "homepage_url": "https://github.com/jotafeldmann/profile-signals"
}
